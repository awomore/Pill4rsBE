# Copy to .env and fill in the values: cp .env.example .env

# --- Server ---
PORT=8080
# Browser origin of the frontend. Used for CORS and as the post-OAuth redirect target.
FRONTEND_ORIGIN=http://localhost:3000

# --- Database / cache ---
# Local-dev defaults. docker-compose overrides these to the in-network service names.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pill4rs?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- Auth / crypto ---
# Long random secret used to sign JWT access tokens.
JWT_SECRET=change-me-to-a-long-random-secret
# Key used to AES-256-GCM encrypt stored ad-platform tokens.
# A 32-byte value is used as-is; any other string is SHA-256 derived to 32 bytes.
TOKEN_ENCRYPTION_KEY=change-me-to-a-32-byte-encryption-key

# --- Anthropic (the "Oma" copilot) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Meta (Facebook) Ads integration ---
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# IMPORTANT: this must point at THIS backend's callback, not the frontend.
META_REDIRECT_URI=http://localhost:8080/api/integrations/meta/callback

# --- Google OAuth login (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
